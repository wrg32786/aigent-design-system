{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wrg32786/aigent-design-system/studio/canvas.schema.json",
  "title": "AIgent Studio Canvas journal",
  "type": "object",
  "required": ["schemaVersion", "revision", "cursor", "operations", "annotations", "components", "checkpoints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "cursor": { "type": "integer", "minimum": -1 },
    "operations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "kind", "createdAt", "author"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["style", "text", "attribute", "remove", "move", "insert"] },
          "nodeId": { "type": "string" },
          "nodeIds": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
          "property": { "type": "string" },
          "value": { "type": "string" },
          "breakpoint": { "enum": ["base", "tablet", "mobile"] },
          "name": { "type": "string" },
          "direction": { "enum": ["up", "down"] },
          "position": { "enum": ["before", "after", "inside"] },
          "html": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "author": {
            "type": "object",
            "required": ["id", "name", "color"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "color": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "annotations": { "type": "array" },
    "components": { "type": "array" },
    "checkpoints": { "type": "array" }
  },
  "additionalProperties": false
}
