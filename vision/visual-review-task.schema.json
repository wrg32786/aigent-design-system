{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaigent.xyz/schemas/visual-review-task.schema.json",
  "title": "AIgent Vision Review Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "status", "target", "pageUrl", "mechanicalReport", "requiredViewports", "dimensions", "captures", "elementMap", "requiredOutput"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "awaiting-review" },
    "target": { "type": "string" },
    "pageUrl": { "type": "string", "format": "uri" },
    "mechanicalReport": { "type": "string", "minLength": 1 },
    "requiredViewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dimensions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 2 },
          "prompt": { "type": "string", "minLength": 20 }
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewport", "width", "height", "reducedMotion", "original", "annotated"],
        "properties": {
          "viewport": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "reducedMotion": { "type": "boolean" },
          "original": { "type": "string", "minLength": 1 },
          "annotated": { "type": "string", "minLength": 1 }
        }
      }
    },
    "elementMap": { "type": "string", "minLength": 1 },
    "requiredOutput": { "type": "string", "minLength": 1 }
  }
}
