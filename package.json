{
  "name": "aigent-design-system",
  "version": "1.3.0",
  "private": false,
  "description": "Agent-native design operating system for Claude Code, Codex, and capable coding agents: design intelligence, creative production, browser QA, Taste, Resolve, and Vision.",
  "type": "module",
  "bin": {
    "aigent-design": "scripts/cli.mjs"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "plan": "node scripts/plan-design.mjs",
    "inspire": "node scripts/inspire.mjs",
    "resolve": "node scripts/resolve-design.mjs",
    "resolve:check": "node scripts/check-resolve.mjs",
    "vision": "node scripts/vision-review.mjs",
    "vision:check": "node scripts/check-vision.mjs",
    "audit": "node scripts/design-audit.mjs",
    "taste": "node scripts/design-audit.mjs --taste-only",
    "taste:check": "node scripts/check-taste.mjs",
    "assets": "node scripts/check-assets.mjs",
    "catalogs": "node scripts/check-catalogs.mjs",
    "intelligence": "node scripts/check-intelligence.mjs",
    "inspiration": "node scripts/check-inspiration.mjs",
    "registry": "node scripts/check-registry.mjs",
    "eval": "node scripts/check-evals.mjs",
    "score": "node scripts/score-design.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "inspiration:smoke": "node scripts/inspiration-smoke.mjs",
    "capture": "node scripts/capture.mjs",
    "publish": "node scripts/publish-site.mjs",
    "publish:check": "node scripts/check-publish.mjs"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "claude-code",
    "codex",
    "design-system",
    "design-intelligence",
    "visual-critique",
    "vision-review",
    "design-resolver",
    "design-forensics",
    "inspiration-intelligence",
    "creative-production",
    "cinematic-web",
    "immersive-web",
    "design-tokens",
    "design-audit",
    "browser-qa",
    "asset-pipeline",
    "sales-deck",
    "product-interface",
    "scroll-animation",
    "video-scrub",
    "3d-web",
    "spline",
    "gsap",
    "threejs",
    "remotion",
    "hyperframes",
    "design-to-code",
    "website-builder",
    "deployment",
    "static-publishing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  }
}
