{
  "name": "aigent-design-system",
  "version": "1.2.0",
  "private": false,
  "description": "An installable agent-native design studio with a native desktop installer, DOM-backed visual canvas, live coding agents, verified one-click publishing, HyperFrames, Resolve, and Vision.",
  "type": "module",
  "bin": {
    "aigent-design": "scripts/cli.mjs"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "plan": "node scripts/plan-design.mjs",
    "inspire": "node scripts/inspire.mjs",
    "resolve": "node scripts/resolve-design.mjs",
    "resolve:check": "node scripts/check-resolve.mjs",
    "vision": "node scripts/vision-review.mjs",
    "vision:check": "node scripts/check-vision.mjs",
    "audit": "node scripts/design-audit.mjs",
    "taste": "node scripts/aigent-taste.mjs",
    "taste:check": "node scripts/check-taste.mjs",
    "assets": "node scripts/check-assets.mjs",
    "catalogs": "node scripts/check-catalogs.mjs",
    "intelligence": "node scripts/check-intelligence.mjs",
    "inspiration": "node scripts/check-inspiration.mjs",
    "registry": "node scripts/check-registry.mjs",
    "eval": "node scripts/check-evals.mjs",
    "score": "node scripts/score-design.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "inspiration:smoke": "node scripts/inspiration-smoke.mjs",
    "capture": "node scripts/capture.mjs",
    "studio": "node scripts/studio-server.mjs",
    "studio:check": "node --check studio/app.js && node --check studio/publish.js && node --check studio/bridge.js && node scripts/check-studio.mjs",
    "studio:context-check": "node scripts/check-agent-context.mjs",
    "desktop:assets": "node scripts/generate-desktop-assets.mjs",
    "desktop:prepare": "node scripts/prepare-desktop-build.mjs",
    "desktop:start": "electron .",
    "desktop:check": "node scripts/check-desktop.mjs",
    "desktop:smoke": "electron . --smoke-test --no-sandbox",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "desktop:dist:win": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --mac dmg zip",
    "desktop:smoke:packaged": "node scripts/smoke-packaged-desktop.mjs",
    "desktop:verify-release": "node scripts/verify-desktop-release.mjs",
    "publish": "node scripts/publish-site.mjs",
    "publish:check": "node scripts/check-publish.mjs"
  },
  "keywords": [
    "ai",
    "design-system",
    "visual-critique",
    "vision-review",
    "design-resolver",
    "design-forensics",
    "inspiration-intelligence",
    "creative-production",
    "cinematic-web",
    "immersive-web",
    "design-intelligence",
    "code-registry",
    "design-tokens",
    "design-audit",
    "browser-qa",
    "asset-pipeline",
    "sales-deck",
    "product-interface",
    "scroll-animation",
    "video-scrub",
    "3d-web",
    "spline",
    "gsap",
    "threejs",
    "remotion",
    "claude-code",
    "codex",
    "agent-skills",
    "website-builder",
    "agent-ui",
    "interactive-studio",
    "visual-canvas",
    "direct-manipulation",
    "design-to-code",
    "collaborative-design",
    "dom-editor",
    "desktop-app",
    "install-wizard",
    "nsis",
    "dmg",
    "auto-update",
    "deployment",
    "static-publishing",
    "netlify",
    "vercel",
    "cloudflare-pages",
    "custom-domain"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.mjs",
  "dependencies": {
    "electron-updater": "6.8.9",
    "playwright": "^1.61.1"
  }
}
