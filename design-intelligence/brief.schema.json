{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaigent.xyz/schemas/design-brief.schema.json",
  "title": "AIgent design brief",
  "type": "object",
  "required": [
    "name",
    "modes",
    "audience",
    "visitorGoal",
    "productMechanism",
    "contentProfile",
    "interactionLevel",
    "framework",
    "brand",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 2},
    "modes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["persuade","operate","read","experience"]}},
    "audience": {"type":"string","minLength":8},
    "visitorGoal": {"type":"string","minLength":8},
    "productMechanism": {"type":"string","minLength":8},
    "proof": {"type":"array","items":{"type":"string","minLength":2},"default":[]},
    "contentProfile": {"enum":["narrative","data-heavy","transactional","editorial","gallery","mixed"]},
    "contentLength": {"enum":["short","medium","long"],"default":"medium"},
    "density": {"enum":["low","medium","high"],"default":"medium"},
    "interactionLevel": {"enum":["static","low","medium","high"]},
    "media": {"type":"object","required":["available","needsProduction"],"additionalProperties":false,"properties":{"available":{"type":"array","uniqueItems":true,"items":{"enum":["none","images","video","3d","data","audio"]}},"needsProduction":{"type":"boolean"},"preferred":{"enum":["auto","still","css","video","frame-sequence","model-viewer","spline","threejs","remotion","rive"],"default":"auto"}}},
    "framework": {"enum":["vanilla","react","next","astro","vue","svelte","other"]},
    "brand": {"type":"object","required":["existingWorld","adjectives","antiReferences","themePreference"],"additionalProperties":false,"properties":{"existingWorld":{"type":"boolean"},"adjectives":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":2}},"antiReferences":{"type":"array","items":{"type":"string","minLength":2}},"themePreference":{"enum":["auto","light","dark"]}}},
    "constraints": {"type":"object","required":["mobilePriority","reducedMotion","maxInitialKB","noWebGL","noAutoplay","accessibility"],"additionalProperties":false,"properties":{"mobilePriority":{"type":"boolean"},"reducedMotion":{"type":"boolean"},"maxInitialKB":{"type":"integer","minimum":100,"maximum":10000},"noWebGL":{"type":"boolean"},"noAutoplay":{"type":"boolean"},"accessibility":{"enum":["AA","AAA"]}}}
  }
}
